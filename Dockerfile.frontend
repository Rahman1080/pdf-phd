# Dockerfile for PDF PhD Frontend
# --------------------------------
# Stage 1: Build the React application
FROM node:20-bullseye-slim AS build

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy source code and build
COPY . .
RUN npm run build

# Stage 2: Serve the application using Nginx
FROM nginx:alpine

# Copy the built assets to Nginx's serve directory
COPY --from=build /app/dist /usr/share/nginx/html

# Create proper Nginx config that serves static files AND handles SPA routing
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
listen 80;
server_name pdfphd.com www.pdfphd.com;
root /usr/share/nginx/html;
index index.html;

# Enable gzip compression for better performance
gzip on;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

# Allow large file uploads for PDF processing
client_max_body_size 100M;

# Serve static files directly (robots.txt, sitemap.xml, images, etc.)
location ~* \.(txt|xml|ico|png|jpg|jpeg|gif|svg|css|js|woff|woff2|ttf|eot)$ {
try_files $uri =404;
expires 30d;
add_header Cache-Control "public, immutable";
}

# Serve robots.txt directly
location = /robots.txt {
try_files $uri =404;
access_log off;
log_not_found off;
}

# Serve sitemap.xml directly
location = /sitemap.xml {
try_files $uri =404;
add_header Content-Type "application/xml";
access_log off;
}

# Serve verification files (Google, Bing, Yandex)
location ~* ^/[a-zA-Z0-9_-]+\.(html)$ {
try_files $uri /index.html;
}

# Handle SPA routing - all other requests go to index.html
location / {
try_files $uri $uri/ /index.html;
}

# Security headers
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "1; mode=block" always;
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
